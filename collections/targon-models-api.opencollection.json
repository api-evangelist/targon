{
  "opencollection": "1.0.0",
  "info": {
    "name": "Targon Chat Models API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targon.com/v1/models"
          },
          "docs": "Lists the models currently available on Targon. The catalog can be extended permissionlessly by the community."
        },
        {
          "info": {
            "name": "Retrieve a model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.targon.com/v1/models/:model",
            "params": [
              {
                "name": "model",
                "value": "",
                "type": "path",
                "description": "The id of the model to retrieve."
              }
            ]
          },
          "docs": "Retrieves metadata for a single model by id."
        }
      ]
    }
  ],
  "bundled": true
}